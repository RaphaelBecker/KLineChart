{
  "compilerOptions": {
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "target": "ES2015",
    "moduleResolution": "node",
    "types": ["node"],
    "esModuleInterop": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "lib": [
      "dom",
      "es2018"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
